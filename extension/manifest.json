{
  "manifest_version": 3,
  "name": "Reel to Codex self-chat collector",
  "version": "1.0.0",
  "description": "Collects new Instagram Reel links and notes only while the configured WhatsApp Message Yourself chat is active.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://127.0.0.1:8787/*"
  ],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [{
    "matches": ["https://web.whatsapp.com/*"],
    "js": ["config.js", "content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_popup": "popup.html", "default_title": "Reel to Codex" }
}
