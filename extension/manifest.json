{
  "manifest_version": 3,
  "name": "WhatsApp to Codex Gateway",
  "version": "2.1.0",
  "description": "Connects the configured WhatsApp Message Yourself chat to a local Codex gateway with read-only task execution.",
  "key": "",
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://127.0.0.1:8787/*"
  ],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [{
    "matches": ["https://web.whatsapp.com/*"],
    "js": ["config.js", "content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_popup": "popup.html", "default_title": "WhatsApp to Codex" }
}
